# App Store metadata only: the texts per locale live in fastlane/metadata. Builds are uploaded from Xcode.
# The App Store Connect API key is read from 1Password at runtime; nothing secret is stored in this repo.

require "deliver"
require "deliver/setup"

OP_ITEM = "op://Private/2k7rag4gyboziazsrvrz4dda6u"
APP_IDENTIFIER = "com.tx2z.aisight"
PLATFORMS = %w[ios osx].freeze

def metadata_path
  File.join(File.expand_path(FastlaneCore::FastlaneFolder.path), "metadata")
end

def op_read(field)
  value = `op read "#{OP_ITEM}/#{field}"`.strip
  UI.user_error!("Could not read #{field} from 1Password (is `op` signed in?)") if value.empty?
  value
end

def api_key
  app_store_connect_api_key(
    key_id: op_read("key_id"),
    issuer_id: op_read("issuer_id"),
    key_content: op_read("private_key"),
    in_house: false
  )
end

desc "Download the texts of the latest iOS version into fastlane/metadata (overwrites local files)"
lane :download_metadata do
  options = FastlaneCore::Configuration.create(Deliver::Options.available_options, {
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    platform: "ios",
    metadata_path: metadata_path,
    skip_screenshots: true
  })
  Deliver::Runner.new(options)
  app = Deliver.cache[:app]
  version = app.get_latest_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
  Deliver::Setup.new.generate_metadata_files(app, version, metadata_path, { use_live_version: false })
end

desc "Upload the texts in fastlane/metadata to the editable version on iOS and macOS (no binary, no screenshots, no review submission)"
lane :upload_metadata do
  key = api_key
  PLATFORMS.each do |platform|
    deliver(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      platform: platform,
      metadata_path: metadata_path,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end
end
